{
  "name": "MeowMD - Markdown Viewer and Editor",
  "short_name": "MeowMD",
  "description": "Fast, privacy-first technical Markdown viewer, live editor, and documentation workstation with Mermaid diagrams, LaTeX math, and 3D molecule support.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fafafa",
  "theme_color": "#fafafa",
  "icons": [
    {
      "src": "assets/img/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "./mdviewer.html",
      "accept": {
        "text/markdown": [
          ".md",
          ".markdown"
        ],
        "text/plain": [
          ".txt"
        ],
        "application/x-ipynb+json": [
          ".ipynb"
        ],
        "text/csv": [
          ".csv",
          ".tsv"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "shortcuts": [
    {
      "name": "Markdown Viewer",
      "url": "./mdviewer.html",
      "description": "Open and read Markdown files"
    },
    {
      "name": "Markdown Editor",
      "url": "./mdeditor.html",
      "description": "Write Markdown visually"
    }
  ]
}
